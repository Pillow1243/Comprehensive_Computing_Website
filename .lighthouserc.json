{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs",
      "startServerReadyPattern": "Static export at",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:4173/Comprehensive_Computing_Website/",
        "http://127.0.0.1:4173/Comprehensive_Computing_Website/formula/quadratic/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 915,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1600
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 4000
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 400
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "server-response-time": [
          "warn",
          {
            "maxNumericValue": 800
          }
        ],
        "uses-responsive-images": [
          "warn",
          {
            "maxLength": 0
          }
        ],
        "unused-javascript": [
          "warn",
          {
            "maxLength": 0
          }
        ],
        "is-crawlable": "error",
        "color-contrast": "error",
        "tap-targets": "error",
        "meta-viewport": "error",
        "installable-manifest": "error",
        "service-worker": "warn",
        "maskable-icon": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "artifacts/lighthouse",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%-report.%%EXTENSION%%"
    }
  }
}
