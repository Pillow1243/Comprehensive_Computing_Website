{
  "name": "solve-everything",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "description": "SolveEverything v3 \u2014 offline-first scientific formula solver, unit converter, periodic table and constants reference (Next.js static export)",
  "scripts": {
    "predev": "npm run build:workers && npm run build:index",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run build:workers && npm run build:index",
    "build": "next build",
    "build:workers": "esbuild workers/compute-worker.ts --bundle --format=iife --platform=browser --target=es2019 --outfile=public/workers/compute-worker.js --minify --log-level=warning",
    "start": "node scripts/serve-static.mjs",
    "sync-registry": "node scripts/sync-formula-catalog.mjs",
    "validate-registry": "node scripts/validate-registry.mjs",
    "test": "vitest run && node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "lighthouse:ci": "node scripts/run-lighthouse-ci.mjs",
    "check": "npm run validate-registry && npm run test",
    "icons": "node scripts/generate-icons.mjs",
    "build:index": "node scripts/build-formula-index.mjs",
    "budget": "node scripts/check-budget.mjs",
    "test:all": "npm run validate-registry && npm test && npm run build && npm run budget"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "mathjs": "^15.2.0",
    "next": "16.4.3",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "8.20.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.25.11",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.5.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "and_chr >= 111",
    "ios_saf >= 16.4"
  ]
}