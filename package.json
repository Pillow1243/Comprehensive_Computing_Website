{
  "name": "solve-everything",
  "version": "5.0.0",
  "private": false,
  "type": "module",
  "description": "SolveEverything v3 — offline-first scientific formula solver, unit converter, periodic table and constants reference (Next.js static export)",
  "scripts": {
    "predev": "npm run build:workers && npm run build:index && npm run build:katex",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run build:workers && npm run build:index && npm run build:katex",
    "build": "next build",
    "build:workers": "esbuild workers/compute-worker.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=public/workers/compute-worker.js --minify --log-level=warning",
    "start": "node scripts/serve-static.mjs",
    "sync-registry": "node scripts/sync-formula-catalog.mjs",
    "validate-registry": "node scripts/validate-registry.mjs",
    "test": "vitest run && node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "lighthouse:ci": "node scripts/run-lighthouse-ci.mjs",
    "check": "npm run validate-registry && npm run test",
    "icons": "node scripts/generate-icons.mjs",
    "build:index": "node scripts/build-formula-index.mjs",
    "budget": "node scripts/check-budget.mjs",
    "test:all": "npm run validate-registry && npm test && npm run build && npm run budget",
    "build:katex": "node scripts/build-katex-css.mjs",
    "audit": "npm audit --audit-level=low"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.545.0",
    "next": "16.4.3",
    "postcss": "^8.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "8.20.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "and_chr >= 111",
    "ios_saf >= 16.4"
  ],
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
